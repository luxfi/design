{
  "name": "@luxfi/design",
  "version": "0.1.2",
  "packageManager": "pnpm@11.24.0",
  "description": "Lux Design System — the Lux brand layer over @hanzo/design. Strictly monochrome, dark-default tokens on a true-black ground, plus components and brand assets. CSS + typed programmatic tokens.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxfi/design.git"
  },
  "homepage": "https://lux.network",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./roles.css": "./roles.css",
    "./tailwind.css": "./tailwind.css",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./prompts/*": "./prompts/*",
    "./content/*": "./content/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs",
    "test": "node scripts/check-tokens.mjs",
    "build": "pnpm gen && pnpm test && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hanzo/design": "0.5.24"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "files": [
    "LLM.md",
    "dist",
    "src",
    "scripts",
    "styles.css",
    "roles.css",
    "tailwind.css",
    "tokens",
    "components",
    "prompts",
    "content",
    "docs",
    "assets",
    "guidelines",
    "ui_kits"
  ],
  "keywords": [
    "lux",
    "design-system",
    "design-tokens",
    "brand",
    "monochrome"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
